# Banco de dados
POSTGRES_USER=lotto
POSTGRES_PASSWORD=lotto
POSTGRES_DB=lottolab
DATABASE_URL=postgresql+psycopg://lotto:lotto@db:5432/lottolab

# API
API_PORT=8000
LOG_LEVEL=INFO
# O Vite pula para a porta seguinte quando a 5173 ja esta ocupada (por exemplo, com o
# container do front no ar e um npm run dev local ao mesmo tempo).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176

# IA (opcional, a aplicacao funciona sem chave)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2

# Front
VITE_API_URL=http://localhost:8000/api
